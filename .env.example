PORT=3000
API_HOST_PORT=3000
FORGEJO_HOST_PORT=3001
TEMPORAL_HOST_PORT=7233
PREVIEW_MANAGER_HOST_PORT=3002
DATABASE_URL=postgresql://orchestra:orchestra@localhost:5432/orchestra
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Host development defaults to all queue groups in one process. Compose
# overrides these to separate project, activity, agent, brain, and inference
# services. Select one role or a safe group to dedicate a physical worker.
ORCHESTRA_WORKER_MODE=all
AGENT_WORKER_ROLES=all
MODEL_WORKER_MODE=all
MODEL_WORKER_ROLES=all
# Compatibility queue retained only for workflow histories created before the
# per-role model workflow split.
MODEL_TASK_QUEUE=orchestra-models
FORGEJO_URL=http://localhost:3001
FORGEJO_PUBLIC_URL=http://localhost:3001
FORGEJO_ADMIN_USER=orchestra-agent
FORGEJO_ADMIN_PASSWORD=orchestra-local-admin-change-me
FORGEJO_ADMIN_EMAIL=agent@orchestra.local
# Keep false locally so Orchestra repository links work without Forgejo login.
# Registration is disabled, so private repos appear as 404 to anonymous browsers.
FORGEJO_REPO_PRIVATE=false
# Prefer a repository-scoped Forgejo token with read:repository for previews.
# Local Compose falls back to the bootstrap account when this is empty.
FORGEJO_PREVIEW_TOKEN=
# Explicit side-effect capabilities granted to the approved-iteration lifecycle.
FORGEJO_LIFECYCLE_PERMISSIONS=pull_requests:comment,pull_requests:merge,issues:close,labels:write,projects:write,releases:write,packages:write,wiki:write
# Compose runs the built-in local Docker preview manager at this endpoint.
# Override it only with an adapter that implements packages/contracts/src/preview.ts.
PREVIEW_DEPLOY_WEBHOOK_URL=http://preview-manager:3002/previews
PREVIEW_DEPLOY_TOKEN=orchestra-local-preview-change-me
PREVIEW_DEPLOY_TIMEOUT_MS=600000
# A deterministic *.localhost URL is generated through this browser gateway.
PREVIEW_GATEWAY_PUBLIC_ORIGIN=http://localhost:3003
PREVIEW_TTL_MS=86400000
PREVIEW_MAX_ACTIVE=8
PREVIEW_BUILD_TIMEOUT_MS=600000
PREVIEW_HEALTH_TIMEOUT_MS=90000
# `default` permits dependency installation while building. Set `none` for
# dependency-free repositories when build-time network isolation is required.
PREVIEW_BUILD_NETWORK_MODE=default
# Inference backend: ollama (local, one-at-a-time) or openrouter (hosted, parallel).
MODEL_PROVIDER=ollama
# Optional per-role override, for example:
# MODEL_PROVIDER_REVIEWER=openrouter
# Optional override for concurrent inference Activities. Defaults to 1 for
# ollama and 8 for openrouter.
# MODEL_INFERENCE_CONCURRENCY=8
# Shared request deadline (ms). Falls back to provider-specific timeouts below.
# MODEL_TIMEOUT_MS=1500000
OLLAMA_HOST=http://host.docker.internal:11434
# Overall Ollama chat deadline (ms). Must cover slow local generations; Node fetch's
# undici headersTimeout is 5m and is intentionally bypassed by the model worker.
OLLAMA_TIMEOUT_MS=1500000
OLLAMA_MODEL_DEFAULT=qwen3.5:9b
OLLAMA_MODEL_MANAGER=qwen3.5:9b
OLLAMA_MODEL_REQUIREMENTS=qwen3.5:9b
OLLAMA_MODEL_PRODUCT=qwen3.5:9b
OLLAMA_MODEL_UX=qwen3.5:9b
OLLAMA_MODEL_ARCHITECTURE=qwen3.5:27b
OLLAMA_MODEL_DATA=qwen3.5:27b
OLLAMA_MODEL_SECURITY=gpt-oss:20b
OLLAMA_MODEL_PLANNER=qwen3.5:27b
OLLAMA_MODEL_BUILDER=qwen2.5-coder:32b
OLLAMA_MODEL_TEST=qwen2.5-coder:32b
OLLAMA_MODEL_REVIEWER=gpt-oss:20b
OLLAMA_MODEL_GATE=gpt-oss:20b
OLLAMA_MODEL_DEPLOYMENT=gpt-oss:20b
OLLAMA_MODEL_VALIDATION=qwen3.5:9b
# OpenRouter (used when MODEL_PROVIDER=openrouter).
OPENROUTER_API_KEY=
# Required acknowledgement: OpenRouter receives the role prompt, project context,
# prior artifacts, and human feedback needed for the selected role.
OPENROUTER_ALLOW_REMOTE_DATA=false
# Optional comma-separated policy allowlist. A configured role model outside it is rejected.
# OPENROUTER_ALLOWED_MODELS=qwen/qwen3.5-9b,anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Limits are selected per role and purpose in the model worker. These optional
# values override every role; prefer a scoped override such as
# OPENROUTER_MAX_TOKENS_MANAGER_GENERATE=3072 when tuning one stage.
# OPENROUTER_TIMEOUT_MS=
# Idle time inherits the role/purpose deadline by default. A scoped override,
# such as OPENROUTER_IDLE_TIMEOUT_MS_PLAN=120000, can tighten one stage.
# OPENROUTER_IDLE_TIMEOUT_MS=
# OPENROUTER_MAX_TOKENS=
# Optional second-attempt ceiling. It is used only after an output-length
# failure and remains constrained by the request's total token/cost budget.
# OPENROUTER_RETRY_MAX_TOKENS=
# OPENROUTER_REASONING_MAX_TOKENS=
OPENROUTER_HTTP_ATTEMPTS=2
# Generation/revision default to throughput; quality review defaults to latency.
# OPENROUTER_PROVIDER_SORT=
MODEL_MAX_RESPONSE_BYTES=1000000
TEMPORAL_PAYLOAD_REFERENCE_THRESHOLD_BYTES=131072
TEMPORAL_PAYLOAD_REFERENCE_MAX_BYTES=20971520
MODEL_MAX_ARTIFACT_CONTEXT_BYTES=1500000
OPENROUTER_MAX_STREAM_BYTES=10000000
# Optional attribution headers recommended by OpenRouter.
# OPENROUTER_HTTP_REFERER=http://localhost:8088
# OPENROUTER_APP_TITLE=Orchestra
OPENROUTER_MODEL_DEFAULT=qwen/qwen3.5-9b
OPENROUTER_MODEL_MANAGER=openai/gpt-5-mini
OPENROUTER_MODEL_REQUIREMENTS=openai/gpt-5-mini
OPENROUTER_MODEL_PRODUCT=openai/gpt-5-mini
OPENROUTER_MODEL_UX=openai/gpt-5-mini
OPENROUTER_MODEL_ARCHITECTURE=openai/gpt-5-mini
OPENROUTER_MODEL_DATA=openai/gpt-5-mini
OPENROUTER_MODEL_SECURITY=openai/gpt-oss-120b
OPENROUTER_MODEL_PLANNER=openai/gpt-5-mini
OPENROUTER_MODEL_BUILDER=qwen/qwen3-coder
OPENROUTER_MODEL_TEST=qwen/qwen3-coder
OPENROUTER_MODEL_REVIEWER=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_GATE=openai/gpt-oss-120b
OPENROUTER_MODEL_DEPLOYMENT=openai/gpt-oss-120b
OPENROUTER_MODEL_VALIDATION=openai/gpt-5-mini
